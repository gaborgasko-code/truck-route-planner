# Truck Route Planner - analytics function parameters.
#
# Non-secret deploy-time configuration, deliberately committed so a deploy is
# reproducible and nobody has to remember these values. The dashboard token is
# NOT here: it lives in Secret Manager, set with
#   firebase functions:secrets:set ANALYTICS_TOKEN
#
# created by Gabor Gasko

# Only these origins may POST events. A wildcard would let any site write into
# the counters.
ANALYTICS_ORIGINS=https://planificador.ggabor.online

# Days a raw event is kept. Enforced by the Firestore TTL policy on expiresAt,
# which is a one-time setup step per collection - see backend/README.md.
ANALYTICS_RETENTION_DAYS=90

# Store individual events as well as the daily rollup. Setting this to false
# halves the write cost but makes the rollup impossible to rebuild later.
ANALYTICS_STORE_RAW=true

# The hard spending stop: past this many events in a UTC day the collector
# answers normally and stops writing. Firestore's no-cost quota is 20,000
# writes a day and an event costs two, so this leaves real headroom. Set to 0
# to remove the stop, which only makes sense if you are content to be billed.
ANALYTICS_DAILY_CAP=8000
