# Never commit the real project id or any emulator state.
.firebaserc
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.runtimeconfig.json
functions/node_modules/
.secret.local

# Emulator and local parameter files. .env.local is generated by
# `firebase emulators:start` and .secret.local holds secret values for it;
# neither belongs in the repository even when it looks harmless today.
functions/.env.local
functions/.secret.local
*.local
